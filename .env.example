  SNOWFLAKE_ACCOUNT=
  SNOWFLAKE_USER=
  # Key-pair auth (preferred). Base64-encoded PEM, or the PEM itself.
  SNOWFLAKE_PRIVATE_KEY=
  SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
  # Password auth is a local-dev fallback only; blocked by MFA on human accounts.
  SNOWFLAKE_PASSWORD=
  SNOWFLAKE_WAREHOUSE=
  SNOWFLAKE_ROLE=
  SNOWFLAKE_DATABASE=TEG_PROD
  SNOWFLAKE_SCHEMA=DW
